# Copy to .env (git-ignored) and fill in. A read-only token for the victron bucket is enough.
INFLUX_TOKEN=
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=sp_inc
INFLUX_BUCKET=victron
TZ=America/Los_Angeles
PRICE_PER_KWH=0.48
REFRESH_SECONDS=30
# The Kindle's routes (images, taps) need this. Generate with: openssl rand -hex 16
# and put the same value in TOKEN in the Kindle's kindledash/config.sh.
CONTROL_TOKEN=
# Login for /admin and /status in a browser (user: admin)
ADMIN_PASSWORD=
# Optional: only serve the Kindle's routes to these IPs (the Kindle's DHCP reservation)
CONTROL_ALLOW_IPS=
# Kasa plugs for the lights page, by IP, in display order; "=kind" labels the tile
# e.g. KASA_HOSTS=192.168.113.14=light,192.168.113.44=fan,192.168.113.36=ev charger
KASA_HOSTS=
