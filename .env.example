# Copy to .env (git-ignored) and fill in. A read-only token for the victron and bluetti buckets is enough.
INFLUX_TOKEN=
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=sp_inc
INFLUX_BUCKET=victron
TZ=America/Los_Angeles
PRICE_PER_KWH=0.48
REFRESH_SECONDS=30
# The Kindle's routes (images, taps) need this. Generate with: openssl rand -hex 16
# and put the same value in TOKEN in the Kindle's kindledash/config.sh.
CONTROL_TOKEN=
# Login for /admin and /status in a browser (user: admin)
ADMIN_PASSWORD=
# Optional: only serve the Kindle's routes to these IPs (the Kindle's DHCP reservation)
CONTROL_ALLOW_IPS=
# Apple TV for the TV page (pair it at /admin), and up to 4 app shortcuts as Name=bundle.id
# (/admin lists the installed apps once paired)
ATV_HOST=
ATV_APPS=
# Kasa plugs for the lights page, by IP, in display order; "=kind" labels the tile
# e.g. KASA_HOSTS=192.168.113.14=light,192.168.113.44=fan,192.168.113.36=ev charger
KASA_HOSTS=
# Bluetti page (bluetti2influx): the bucket, and models to show in order with their capacity in Wh
BLUETTI_BUCKET=bluetti
BLUETTI_STATIONS=AP300=2764.8,AC180=1152
# UniFi Protect for the CAMERA page: the console's address and a local account (a Protect
# "View Only" user is enough), and the cameras by their Protect name, with an optional label
PROTECT_HOST=
PROTECT_USER=
PROTECT_PASSWORD=
PROTECT_CAMERAS=garageCam=Outer garage

# Car page: your MyHyundai / Blue Link login and 4-digit PIN (US)
BLUELINK_USER=
BLUELINK_PASSWORD=
BLUELINK_PIN=
# Optional: how often Hyundai's copy is read (the car stays asleep), the least time
# between taps that wake the car, and what START CLIMATE sets (°F, 1-30 minutes)
CAR_REFRESH_SECONDS=1800
CAR_WAKE_MIN_SECONDS=1800
CAR_CLIMATE_TEMP=72
CAR_CLIMATE_MINUTES=10
